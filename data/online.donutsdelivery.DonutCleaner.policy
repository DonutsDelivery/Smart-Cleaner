<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC
  "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
  "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>DonutsDelivery</vendor>
  <vendor_url>https://github.com/DonutsDelivery/Smart-Cleaner</vendor_url>
  <icon_name>online.donutsdelivery.DonutCleaner</icon_name>

  <!-- DonutCleaner starts each of these as `pkexec <absolute path> <args>`.
       The exec.path values below must match the paths in src/remover/safe.rs. -->

  <action id="online.donutsdelivery.DonutCleaner.remove-files">
    <description>Delete files that need administrator rights</description>
    <message>Authentication is required for DonutCleaner to delete files that only an administrator can remove</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/bin/rm</annotate>
    <annotate key="org.freedesktop.policykit.exec.allow_gui">true</annotate>
  </action>

  <action id="online.donutsdelivery.DonutCleaner.remove-packages">
    <description>Uninstall system packages</description>
    <message>Authentication is required for DonutCleaner to uninstall system packages</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/bin/pacman</annotate>
    <annotate key="org.freedesktop.policykit.exec.allow_gui">true</annotate>
  </action>

  <action id="online.donutsdelivery.DonutCleaner.clean-package-cache">
    <description>Clean the pacman package cache</description>
    <message>Authentication is required for DonutCleaner to delete old packages from the pacman cache</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/bin/paccache</annotate>
    <annotate key="org.freedesktop.policykit.exec.allow_gui">true</annotate>
  </action>

  <action id="online.donutsdelivery.DonutCleaner.trim-journal">
    <description>Trim the system journal</description>
    <message>Authentication is required for DonutCleaner to delete old systemd journal entries</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/bin/journalctl</annotate>
    <annotate key="org.freedesktop.policykit.exec.allow_gui">true</annotate>
  </action>
</policyconfig>
